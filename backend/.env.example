# Copy to .env and fill in. The scheme MUST be postgresql+psycopg:// (psycopg v3);
# a bare postgresql:// makes SQLAlchemy look for psycopg2, which isn't installed.

# --- Database (required) ---
# Local Docker Postgres (from docker-compose.yml):
DATABASE_URL=postgresql+psycopg://star:password@localhost:5432/star_crm
#
# Neon (production) — use the POOLED connection string (host has "-pooler"),
# change the scheme to postgresql+psycopg://, and keep ?sslmode=require:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Business-card scanner (required only to use the "Scan card" feature) ---
# Anthropic API key for Claude vision extraction. Get one at console.anthropic.com.
# In production, store this in Secret Manager rather than a plain env var.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the vision model (defaults to a cheap, fast Haiku).
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Microsoft Entra (M365) auth (optional until SSO + connector go live) ---
# Leave unset to keep the current no-auth profile model (X-User-Id header).
# When both are set, the API also accepts Entra Bearer tokens and maps each
# M365 identity to a profile (used by the web SSO login and the Claude connector).
# ENTRA_TENANT_ID=<your-directory-tenant-id>
# ENTRA_CLIENT_ID=<the-API-app-registration-client-id>   # = token audience
# Set only if your token audience is the App ID URI form (api://<client-id>):
# ENTRA_AUDIENCE=api://<client-id>

# --- Starbot chat: M365 sign-in + Claude (all required for the chat tab) ---
# Confidential-client secret from the SAME app registration as ENTRA_CLIENT_ID
# (Entra → app → Certificates & secrets → New client secret → copy the VALUE).
# ENTRA_CLIENT_SECRET=<client-secret-value>
#
# Public origin of this app. The OAuth redirect URI is <PUBLIC_BASE_URL>/api/auth/callback
# and must be registered on the app (Authentication → Web → Redirect URIs).
# Local dev: http://localhost:8000. Azure: the container app https URL.
# PUBLIC_BASE_URL=http://localhost:8000
#
# Signs the session cookie. Any long random string; if unset, an ephemeral one
# is generated at boot (all sessions log out on every restart/redeploy).
# SESSION_SECRET=<random-32+-chars>
#
# Where the browser lands after sign-in. Default /#starbot (the chat tab).
# Local dev with Vite on :5173 (callback runs on :8000, cookies carry over):
# POST_LOGIN_REDIRECT=http://localhost:5173/#starbot
#
# Chat model (defaults to claude-sonnet-4-6).
# CHAT_MODEL=claude-sonnet-4-6

# --- CORS (optional) ---
# Comma-separated list of allowed browser origins.
# Local Vite dev server is allowed by default if this is unset.
# FRONTEND_ORIGINS=http://localhost:5173,https://your-frontend.example.com
